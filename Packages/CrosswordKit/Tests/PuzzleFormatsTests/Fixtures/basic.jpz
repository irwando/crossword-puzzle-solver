<?xml version="1.0" encoding="UTF-8"?>
<crossword-compiler-applet xmlns="http://crossword.info/xml/crossword-compiler-applet">
  <applet-settings width="720" height="600"><completion>Done!</completion></applet-settings>
  <rectangular-puzzle xmlns="http://crossword.info/xml/rectangular-puzzle" alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZ">
    <metadata>
      <title>JPZ Test</title>
      <creator>Tester</creator>
      <copyright>© 2026</copyright>
      <description>A test &amp; more</description>
    </metadata>
    <crossword>
      <grid width="3" height="3">
        <grid-look numbering-scheme="normal"/>
        <cell x="1" y="1" solution="C" number="1" background-shape="circle" solve-state="C"/>
        <cell x="2" y="1" solution="A"/>
        <cell x="3" y="1" solution="T" number="2" solve-state="T" solve-status="revealed"/>
        <cell x="1" y="2" solution="A"/>
        <cell x="2" y="2" type="block"/>
        <cell x="3" y="2" solution="E"/>
        <cell x="1" y="3" solution="B" number="3"/>
        <cell x="2" y="3" solution="E"/>
        <cell x="3" y="3" solution="DOG"/>
      </grid>
      <word id="1" x="1-3" y="1"/>
      <word id="2" x="1-3" y="3"/>
      <word id="3" x="1" y="1-3"/>
      <word id="4"><cells x="3" y="1"/><cells x="3" y="2"/><cells x="3" y="3"/></word>
      <clues ordering="normal">
        <title><b>Across</b></title>
        <clue word="1" number="1" format="3">Feline <i>friend</i></clue>
        <clue word="2" number="3" format="3">Sleeping spot</clue>
      </clues>
      <clues ordering="normal">
        <title><b>Down</b></title>
        <clue word="3" number="1" format="3">Taxi</clue>
        <clue word="4" number="2" format="3">Golf peg</clue>
      </clues>
    </crossword>
  </rectangular-puzzle>
</crossword-compiler-applet>
